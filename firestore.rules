rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function perfil() { return get(/databases/$(db)/documents/usuarios/$(request.auth.uid)).data; }
    function activo() { return signed() && exists(/databases/$(db)/documents/usuarios/$(request.auth.uid)) && perfil().activo == true; }
    function admin() { return activo() && perfil().rol == 'admin'; }

    match /usuarios/{uid} {
      allow read: if signed() && (request.auth.uid == uid || activo());
      allow create: if signed() && request.auth.uid == uid
        && request.resource.data.activo == false
        && request.resource.data.rol == 'usuario'
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'activo', 'rol', 'creado']);
      allow update: if admin() && request.auth.uid != uid;
      allow delete: if false;
    }

    match /{col}/{rest=**} {
      allow read, write: if col != 'usuarios' && activo();
    }
  }
}
